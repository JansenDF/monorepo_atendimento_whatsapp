{
  "name": "whatsapp-atendimento",
  "private": true,
  "packageManager": "pnpm@12.7.0",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:e2e": "turbo run test:e2e",
    "check": "pnpm lint && pnpm typecheck && pnpm --filter @whatsapp/api db:validate && pnpm test && pnpm build && pnpm test:e2e",
    "clean": "turbo run clean"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.2.6",
    "globals": "^16.5.0",
    "turbo": "2.10.6",
    "typescript-eslint": "^8.70.1"
  }
}
