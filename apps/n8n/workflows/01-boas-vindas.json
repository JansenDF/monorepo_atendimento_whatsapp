        "jsCode": "const input = $input.first().json;\nconst payload = input.body ?? input;\nconst event = payload.event ?? payload;\nconst message = event.message ?? {};\nconst contact = event.contact ?? event.customer ?? {};\nconst messageText = message.text ?? message.body ?? message.content ?? '';\nconst eventType = event.eventType ?? event.type;\nconst required = ['eventId', 'companyId', 'ticketId', 'integrationId'];\nfor (const field of required) {\n  if (!event[field]) throw new Error('Evento inválido: campo obrigatório ausente: ' + field);\n}\nif (eventType !== 'message.received') throw new Error('Esperado evento message.received');\nif (!message.id) throw new Error('Evento inválido: message.id ausente');\nif (typeof contact.phone !== 'string' || !contact.phone.trim()) throw new Error('Evento inválido: contact.phone ausente');\nreturn [{ json: {\n  eventId: event.eventId,\n  eventType,\n  companyId: event.companyId,\n  ticketId: event.ticketId,\n  integrationId: event.integrationId,\n  customerId: event.customerId ?? contact.id ?? event.customer?.id ?? null,\n  customerName: contact.name ?? event.customer?.name ?? '',\n  phone: contact.phone,\n  messageId: message.id,\n  messageType: message.type ?? 'TEXT',\n  text: String(messageText),\n  qualification: event.qualification ?? null,\n} }];"
      },
