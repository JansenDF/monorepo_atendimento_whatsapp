        "jsCode": "const data = $input.first().json;\nconst name = String(data.customerName ?? '').trim();\nconst text = data.isRegistered\n  ? (name ? 'Olá, ' + name + '! Que bom falar com você novamente. Como podemos ajudar?' : 'Olá! Que bom falar com você novamente. Como podemos ajudar?')\n  : 'Olá! Seja bem-vindo(a) ao nosso atendimento. Como podemos ajudar?';\nreturn [{ json: { ...data, outgoingText: text, idempotencyKey: 'welcome:' + data.eventId } }];"
