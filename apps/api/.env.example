NODE_ENV=development
PORT=3001
DATABASE_URL=postgresql://whatsapp:whatsapp@localhost:5432/whatsapp_atendimento?schema=public
REDIS_URL=redis://localhost:6379
FRONTEND_ORIGINS=http://localhost:3000

# Required for authenticated REST endpoints. Generate with: openssl rand -base64 32
JWT_ACCESS_SECRET=

# AI support (disabled until a provider and company FAQ are configured)
AI_ENABLED=false
AI_PROVIDER=OPENAI
# Automatic replies require a confidence score strictly above 85
OPENAI_API_KEY=
OPENAI_MODEL=
# Azure OpenAI v1 endpoint, e.g. https://your-resource.openai.azure.com
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=

# WhatsApp Cloud API (use the Graph API version currently supported by your Meta app)
# WHATSAPP_GRAPH_API_VERSION=vXX.0
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
# 32 random bytes encoded as hex: openssl rand -hex 32
WHATSAPP_CREDENTIALS_ENCRYPTION_KEY=

# Private S3-compatible bucket used to persist inbound media files.
WHATSAPP_MEDIA_S3_BUCKET=
WHATSAPP_MEDIA_S3_REGION=us-east-1
# Set endpoint for MinIO or another S3-compatible provider; omit for AWS S3.
WHATSAPP_MEDIA_S3_ENDPOINT=
WHATSAPP_MEDIA_S3_ACCESS_KEY_ID=
WHATSAPP_MEDIA_S3_SECRET_ACCESS_KEY=
